<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dao.ZhekouDao">
    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        a.id as id
        ,a.piaozhong as piaozhong
        ,a.zhekou as zhekou
    </sql>
    <select id="selectListView" resultType="com.entity.Zhekou">
        SELECT
        <include refid="Base_Column_List" />
        FROM zhekou  a
        <where>
            <if test=" params.piaozhong != '' and params.piaozhong != null ">
                and a.piaozhong like CONCAT('%',#{params.piaozhong},'%')
            </if>
            <if test="params.zhekou != null">
                and a.zhekou = #{params.zhekou}
            </if>

        </where>

        order by a.${params.orderBy} desc
    </select>

</mapper>
